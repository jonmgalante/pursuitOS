# No environment variables are required for the default demo-first local flow.
#
# Optional: enable live OpenAI note structuring + follow-up draft generation
# instead of deterministic fallback mode.
# OPENAI_API_KEY=
#
# Optional: explicit HubSpot sync mode for the first slice.
# Defaults to mock when unset. Live verification later requires both:
#   HUBSPOT_SYNC_MODE=live
#   HUBSPOT_ACCESS_TOKEN=<token>
# The token can come from env today or a future stub token provider.
# HUBSPOT_SYNC_MODE=mock
#
# Optional: access token for live HubSpot task creation.
# HUBSPOT_ACCESS_TOKEN=
#
# Optional: explicit Gmail sync mode for the first slice.
# Defaults to mock when unset. Live verification later requires both:
#   GMAIL_SYNC_MODE=live
#   GMAIL_ACCESS_TOKEN=<token>
# Gmail remains draft-only in this app; it never calls the Gmail send endpoint.
# GMAIL_SYNC_MODE=mock
#
# Optional: access token for live Gmail draft creation.
# GMAIL_ACCESS_TOKEN=
#
# Optional: opt into the Prisma-backed first-slice repository.
# Defaults to file mode when unset.
# COPILOT_FIRST_SLICE_BACKEND=prisma
#
# Optional: needed for Prisma tooling and Prisma mode if you are not using
# the bundled docker-compose Postgres defaults.
# Defaults to postgresql://copilot:copilot@localhost:5432/conference_copilot
# when unset.
# DATABASE_URL=postgresql://copilot:copilot@localhost:5432/conference_copilot
