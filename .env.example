# No environment variables are required for the default demo-first local flow.
#
# Optional: enable live OpenAI note structuring + follow-up draft generation
# instead of deterministic fallback mode.
# OPENAI_API_KEY=
#
# Optional: enable live HubSpot task creation instead of mock mode.
# HUBSPOT_ACCESS_TOKEN=
#
# Optional: enable live Gmail draft creation instead of mock mode.
# GMAIL_ACCESS_TOKEN=
#
# Optional: opt into the Prisma-backed first-slice repository.
# Defaults to file mode when unset.
# COPILOT_FIRST_SLICE_BACKEND=prisma
#
# Optional: needed for Prisma tooling and Prisma mode if you are not using
# the bundled docker-compose Postgres defaults.
# Defaults to postgresql://copilot:copilot@localhost:5432/conference_copilot
# when unset.
# DATABASE_URL=postgresql://copilot:copilot@localhost:5432/conference_copilot
