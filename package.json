{
  "name": "conference-rep-copilot-mvp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @copilot/web dev",
    "dev:worker": "pnpm --filter @copilot/worker dev",
    "dev:extension": "pnpm --filter @copilot/extension dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @copilot/db prisma generate",
    "db:migrate": "pnpm --filter @copilot/db prisma migrate dev"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
